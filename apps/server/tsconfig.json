{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/shared" },
    { "path": "../../packages/sim-core" },
    { "path": "../../packages/scenario" },
    { "path": "../../packages/scoring" },
    { "path": "../../packages/adaptive" },
    { "path": "../../packages/bots" }
  ],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/testing", "dist"]
}
