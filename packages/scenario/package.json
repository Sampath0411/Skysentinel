{
  "name": "@skysentinel/scenario",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run --root .",
    "scenario:validate": "node dist/cli.js",
    "dev": "echo stub-scenario"
  },
  "dependencies": {
    "@skysentinel/shared": "workspace:*",
    "@skysentinel/sim-core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "typescript": "^5.7.2"
  }
}
